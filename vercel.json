{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/import",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/check.html"
    },
    {
      "source": "/import",
      "destination": "/import.html"
    },
    {
      "source": "/check",
      "destination": "/check.html"
    },
    {
      "source": "/check/:id",
      "destination": "/result-check.html?id=:id"
    },
    {
      "source": "/garage",
      "destination": "/garage.html"
    },
    {
      "source": "/garage/:id",
      "destination": "/garage.html?id=:id"
    }
  ]
}